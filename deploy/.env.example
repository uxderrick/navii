IMAGE=ghcr.io/uxderrick/navii-api:latest

# Umami self-hosted analytics secrets.
# Generate fresh values on the box and commit nothing real.
#   openssl rand -base64 24 | tr -d '=+/'   # for UMAMI_DB_PASSWORD
#   openssl rand -base64 48 | tr -d '=+/'   # for UMAMI_APP_SECRET
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=

# ── Polar.sh (payments + license keys) ────────────────────────────────────
# Polar dashboard → Settings → Access Tokens → create one. Server-only.
POLAR_ACCESS_TOKEN=
# Polar dashboard → Settings → General → Organization ID (UUID).
POLAR_ORGANIZATION_ID=
# Product UUID — Navii Pro. Visible in product detail URL.
POLAR_PRODUCT_ID=e57be7c8-8cb9-4e28-a0c9-e1de2d3be8a8
# License-Key benefit UUID. Open product → Benefits tab → benefit page URL.
# Optional but recommended — rejects keys issued for other products.
POLAR_BENEFIT_ID=
# Where buyer is redirected after paying. {CHECKOUT_ID} placeholder allowed.
POLAR_SUCCESS_URL=https://navii.dev/thanks?checkout_id={CHECKOUT_ID}
# Polar webhook → set URL https://api.navii.dev/polar/webhooks → grab secret.
POLAR_WEBHOOK_SECRET=
# 'production' or 'sandbox'. Use sandbox while testing.
POLAR_SERVER=production
