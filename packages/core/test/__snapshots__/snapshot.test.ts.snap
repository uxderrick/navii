      87%, 89%, 93%, 95% { transform: scaleY(0.06); }
    }
    @keyframes n-sway {
      0%, 100% { transform: rotate(0deg); }
      25%      { transform: rotate(-5deg); }
      75%      { transform: rotate(5deg); }
    }
    @keyframes n-pulse {
      0%, 100% { opacity: 0.55; transform: scale(1); }
      50%      { opacity: 1;    transform: scale(1.32); }
    }
    @keyframes n-twinkle {
      0%, 100% { opacity: 0.3; transform: rotate(0deg) scale(0.85); }
      50%      { opacity: 1;   transform: rotate(180deg) scale(1.12); }
    }
    @media (prefers-reduced-motion: reduce) {
      .n-972feq .body, .n-972feq .eyes, .n-972feq .antenna, .n-972feq .spark, .n-972feq .sparkle { animation: none; }
    }
  </style><g class="n-972feq"><g transform="translate(50 86) scale(0.924) translate(-50 -86)" filter="url(#navii-hue-972feq)"><g class="body"><ellipse cx="50" cy="90" rx="22" ry="2.6" fill="#0F172A" opacity="0.16" /><path d="M50 28 C74 28 88 42 88 60 C88 78 74 86 50 86 C26 86 12 78 12 60 C12 42 26 28 50 28 Z" fill="url(#navii-grad-972feq)" stroke="rgba(15,23,42,0.18)" stroke-width="0.7" /><ellipse cx="38" cy="42" rx="11" ry="7" fill="#FFFFFF" opacity="0.22" transform="rotate(-18 38 42)" /></g></g><g class="eyes"><g stroke="#0F172A" stroke-width="1.6" stroke-linecap="round"><line x1="35.550000000000004" y1="53.6" x2="40.35" y2="58.4" /><line x1="35.550000000000004" y1="58.4" x2="40.35" y2="53.6" /></g><g stroke="#0F172A" stroke-width="1.6" stroke-linecap="round"><line x1="59.65" y1="53.6" x2="64.45" y2="58.4" /><line x1="59.65" y1="58.4" x2="64.45" y2="53.6" /></g></g><path d="M43.112 66 Q50 69 57.888 64" stroke="#0F172A" stroke-width="1.8" stroke-linecap="round" fill="none" /><g transform="rotate(5 50 32)"><g class="antenna"><path d="M50 30 Q51 25 52.5 21" stroke="#0F172A" stroke-width="1.2" stroke-linecap="round" fill="none" opacity="0.55" /><circle class="spark" cx="52.5" cy="20" r="2.6" fill="#F8FAFC" stroke="#0F172A" stroke-width="0.6" opacity="0.95" /></g></g></g></svg>",
  },
]
`;

