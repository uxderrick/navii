{
  "name": "@navii/core",
  "version": "0.0.1",
  "description": "Deterministic mascot avatar engine. Seed in, SVG out.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parts": {
      "types": "./dist/parts/index.d.ts",
      "import": "./dist/parts/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["avatar", "mascot", "svg", "deterministic", "navii"],
  "license": "MIT",
  "sideEffects": false
}
