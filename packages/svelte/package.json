{
  "name": "@usenavii/svelte",
  "version": "0.9.1",
  "description": "Svelte 5 binding for Navii deterministic avatars — <Navii seed=\"...\" />.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "svelte-package --input src",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "avatar",
    "avatars",
    "mascot",
    "svg",
    "svelte",
    "deterministic",
    "navii"
  ],
  "license": "MIT",
  "author": "uxderrick",
  "homepage": "https://navii.uxderrick.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxderrick/navii.git",
    "directory": "packages/svelte"
  },
  "bugs": "https://github.com/uxderrick/navii/issues",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mhaadi/svg": "^0.2.3",
    "@usenavii/core": "workspace:^0.9.1"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "vite": "^8.3.2",
    "jsdom": "^30.1.1"
  }
}
