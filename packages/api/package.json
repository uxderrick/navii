{
  "name": "@usenavii/api",
  "version": "0.0.4",
  "description": "Hosted Navii avatar endpoint. GET /avatar/:seed → SVG.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/dev.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@polar-sh/hono": "^0.5.6",
    "@resvg/resvg-js": "^2.6.2",
    "@usenavii/core": "workspace:*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "license": "MIT"
}
