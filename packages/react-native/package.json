{
  "name": "@usenavii/react-native",
  "version": "0.9.0",
  "description": "React Native binding for Navii deterministic avatars — <Navii seed=\"...\" />.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "avatar",
    "avatars",
    "mascot",
    "svg",
    "react-native",
    "deterministic",
    "navii"
  ],
  "license": "MIT",
  "author": "uxderrick",
  "homepage": "https://navii.uxderrick.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uxderrick/navii.git",
    "directory": "packages/react-native"
  },
  "bugs": "https://github.com/uxderrick/navii/issues",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mhaadi/svg": "^0.2.3",
    "@usenavii/core": "workspace:^0.9.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": ">=15"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  }
}
